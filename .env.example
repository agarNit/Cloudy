ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional — Qdrant powers hybrid retrieval by default. If unset (or the
# instance is unreachable), Cloudy automatically falls back to a local,
# embedded Chroma store for that session — no setup required to get started.
# Set these to use Qdrant Cloud, or point QDRANT_URL at a local instance
# (e.g. docker run -p 6333:6333 qdrant/qdrant -> QDRANT_URL=http://localhost:6333).
QDRANT_URL=
QDRANT_API_KEY=

# Optional — only needed if you enable the GitHub MCP server in servers.json
GITHUB_TOKEN=your-github-token

# Optional — LangSmith tracing (also feeds the eval golden dataset — see Evals in README)
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Optional — Langfuse (cost/latency/usage dashboards; sign up free or self-host).
# Runs alongside LangSmith, not instead of it — each covers a different job.
# Safe to leave unset: the handler degrades to a silent no-op with no credentials.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
